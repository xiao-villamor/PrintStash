**/*-plans.md

# AI assistant tooling. `.agents/` is the source of truth and is tracked in full:
# it holds the shared skills every assistant reads. The per-tool entry points are
# tracked symlinks into it — `.claude/skills` -> `.agents/skills` and
# `CLAUDE.md` -> `AGENTS.md` — so a fresh clone works for each tool with no
# second copy to keep in sync. Everything else here stays local.
.codex/
.mcp.json
.claude/*
!.claude/skills
.opencode/
skills-lock.json
docs/agents/
frontend/test-results/
frontend/playwright-report/
frontend/tests/e2e-real/.data/
frontend/tests/e2e-real/.storage-data/
frontend/tests/e2e-real/.delivery-data/
.playwright-mcp/
screenshots/gif-frames/

# Local integration worktrees
.cloud-integration-*/

# Windows "downloaded from internet" metadata streams (WSL surfaces these)
*:Zone.Identifier

/frontend/tests/performance/.startup-data/

/frontend/.startup-results/

