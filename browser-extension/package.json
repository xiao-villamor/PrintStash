{
  "name": "printstash-browser-extension",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:chrome": "wxt build --browser chrome --mv3",
    "build:edge": "wxt build --browser edge --mv3",
    "build:firefox": "wxt build --browser firefox --mv3",
    "build:all": "pnpm build:chrome && pnpm build:firefox && pnpm build:edge",
    "zip:chrome": "wxt zip --browser chrome --mv3",
    "zip:edge": "wxt zip --browser edge --mv3",
    "zip:firefox": "wxt zip --browser firefox --mv3",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm build:all && vitest run",
    "test:real-backend-capture": "vitest run --config vitest.real-backend.config.ts",
    "test:watch": "vitest",
    "test:e2e": "wdio run wdio.conf.ts"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@wdio/cli": "^9.24.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/mocha-framework": "^9.24.0",
    "@webext-core/fake-browser": "^1.3.0",
    "jsdom": "^29.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3",
    "wxt": "^0.21.4"
  }
}
