{
  "name": "printstash-frontend",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bundle": "vite --experimental-bundle",
    "build": "pnpm run typecheck && vite build",
    "build:react-compiler": "pnpm run typecheck && vite build --mode react-compiler",
    "preview": "vite preview",
    "start": "vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit && pnpm --filter @printstash/ui typecheck && pnpm --filter @printstash/domain typecheck",
    "test": "vitest run && pnpm --filter @printstash/ui test && pnpm --filter @printstash/domain test",
    "test:fast": "vitest run --config vitest.fast.config.ts",
    "test:changed": "vitest run --changed",
    "test:happy-dom": "vitest run --environment happy-dom",
    "test:jsdom": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "pnpm test:coverage && pnpm --filter @printstash/domain test:coverage && pnpm --filter @printstash/ui test:coverage && node scripts/coverage-gate.mjs",
    "test:e2e": "playwright test",
    "test:e2e:bundle": "PLAYWRIGHT_BUNDLED_DEV=1 playwright test",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts && playwright test --config=playwright.onboarding.config.ts && PLAYWRIGHT_ONBOARDING_LOST_RESPONSE=1 playwright test --config=playwright.onboarding.config.ts",
    "test:e2e:critical": "playwright test --config=playwright.real.config.ts --grep @critical && playwright test --config=playwright.storage.config.ts --grep @critical && playwright test --config=playwright.critical-backup.config.ts --grep @critical",
    "test:e2e:storage": "playwright test --config=playwright.storage.config.ts",
    "test:perf": "playwright test --config=playwright.performance.config.ts",
    "test:perf:react-compiler": "PERF_BUILD_MODE=react-compiler playwright test --config=playwright.performance.config.ts",
    "test:frontend": "node scripts/frontend-smoke.mjs",
    "media:readme": "node scripts/generate-readme-media.mjs",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@printstash/domain": "workspace:*",
    "@printstash/ui": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/three": "0.182.0",
    "lucide-react": "^1.17.0",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "three": "0.182.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.11.6",
    "jsdom": "^29.1.1",
    "oxc-parser": "0.146.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 128",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ],
  "packageManager": "pnpm@10.18.1",
  "pnpm": {
    "overrides": {
      "three": "0.182.0"
    }
  }
}
