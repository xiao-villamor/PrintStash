# Deliberately non-secret credentials for the isolated manual-test stack.
# Copy this file to deploy/manual-testing/.env before testing; never
# use these defaults outside a disposable local test environment.

PRINTSTASH_IMAGE_TAG=candidate
PRINTSTASH_HTTP_PORT=3100
PRINTSTASH_API_PORT=8100
PRINTSTASH_DB_PORT=5433
VAULT_MAX_UPLOAD_MB=512
VAULT_STORAGE_BACKEND=s3
VAULT_BACKUP_RETENTION_DAYS=30
VAULT_ACCESS_TOKEN_EXPIRE_MINUTES=60
VAULT_REMEMBER_ME_DAYS=2
VAULT_LOG_LEVEL=INFO
VAULT_OIDC_ENABLED=true
# Default mode: PostgreSQL. For integrated PrintStash backup/restore testing,
# replace this value with sqlite:////data/db/printstash.sqlite and disable OIDC.
VAULT_DB_URL=postgresql+psycopg://printstash:printstash-manual-db@printstash-db:5432/printstash
VAULT_S3_BUCKET=printstash-manual
VAULT_S3_ENDPOINT_URL=http://seaweedfs.localhost:8333
VAULT_S3_REGION=us-east-1
VAULT_S3_PRESIGNED_URL_EXPIRE_SECONDS=900
VAULT_S3_MULTIPART_THRESHOLD_MB=50
VAULT_JWT_SECRET=printstash-manual-only-jwt-secret-change-me
VAULT_SETUP_TOKEN=printstash-manual-setup-token
VAULT_SECRETS_KEY=printstash-manual-only-secrets-key-change-me

POSTGRES_DB=printstash
POSTGRES_USER=printstash
POSTGRES_PASSWORD=printstash-manual-db

SEAWEEDFS_ACCESS_KEY=printstash-manual
SEAWEEDFS_SECRET_KEY=printstash-manual-s3-secret
SEAWEEDFS_MASTER_PORT=9333

# Disposable read-write fixture source mounted outside the private /data tree.
MANUAL_EXTERNAL_LIBRARY_PATH=./deploy/manual-testing/external-library

SPOOLMAN_PORT=7912
SPOOLMAN_ALLOWED_HOSTS=spoolman,localhost,127.0.0.1

# *.localhost resolves to loopback in current browsers. The API container gets
# a Compose network alias for this hostname in docker-compose.manual-test.yml.
PRINTSTASH_OIDC_HOSTNAME=authentik.localhost
PRINTSTASH_OIDC_ISSUER_URL=http://authentik.localhost:9000/application/o/printstash
PRINTSTASH_OIDC_CLIENT_ID=printstash-manual
PRINTSTASH_OIDC_CLIENT_SECRET=printstash-manual-client-secret
PRINTSTASH_OIDC_REDIRECT_URI=http://localhost:3100/api/v1/auth/oidc/callback
PRINTSTASH_OIDC_ADMIN_GROUP=printstash-admins
PRINTSTASH_OIDC_ADMIN_USERNAME=printstash-admin
PRINTSTASH_OIDC_ADMIN_PASSWORD=printstash-admin-test
PRINTSTASH_OIDC_ADMIN_EMAIL=printstash-admin@example.test
PRINTSTASH_OIDC_USER_USERNAME=printstash-user
PRINTSTASH_OIDC_USER_PASSWORD=printstash-user-test
PRINTSTASH_OIDC_USER_EMAIL=printstash-user@example.test

AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=authentik-manual-db
AUTHENTIK_SECRET_KEY=printstash-manual-only-authentik-secret-change-me
AUTHENTIK_BOOTSTRAP_PASSWORD=authentik-admin-test
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.test

MOCK_PRINT_SECONDS=5
MOONRAKER_PORT=7125
OCTOPRINT_PORT=5000
PRUSALINK_PORT=8080
MOCK_OCTOPRINT_API_KEY=printstash-manual-octoprint-key
MOCK_PRUSALINK_API_KEY=printstash-manual-prusalink-key
